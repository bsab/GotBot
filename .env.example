# Required. Create your Telegram bot with @BotFather.
TELEGRAM_TOKEN=
AWS_STORAGE_BUCKET_NAME=

# Prefer an IAM role or an AWS profile (standard boto3 credential chain).
# Optional explicit credentials in environment variables or your local .env:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Never commit real credentials.
AWS_REGION=eu-central-1
MEME_PREFIX=
MEME_CACHE_TTL=300

# Optional numeric Telegram chat ID. Leave empty to disable feedback delivery.
DEVELOPER_CHAT_ID=

# Local development: polling. Production behind HTTPS: webhook.
BOT_MODE=polling
LOG_LEVEL=INFO

# Required only with BOT_MODE=webhook. No bot token in the URL.
# WEBHOOK_URL=https://your-app.example.com
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8080
